# Copiez ce fichier en ".env" (jamais commité) et renseignez vos valeurs.

# Base MongoDB (Atlas ou locale : mongodb://127.0.0.1:27017/proformat)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/proformat?retryWrites=true&w=majority

# Secret de signature des sessions : chaîne aléatoire d'au moins 32 caractères
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Durée de validité d'une session (optionnel, défaut 12h)
JWT_EXPIRES_IN=12h

# Origines autorisées pour l'API, séparées par des virgules (optionnel, défaut : toutes)
# CORS_ORIGIN=https://votre-domaine.vercel.app

PORT=5000
